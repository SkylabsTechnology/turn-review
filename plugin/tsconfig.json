{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["./index.client.tsx", "./index.server.ts", "./client/**/*.tsx", "./client/**/*.ts", "./server/**/*.ts", "./shared/**/*.ts"]
}
